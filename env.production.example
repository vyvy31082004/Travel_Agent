# VietTrip AI production environment example for Azure Container Apps.
# Copy values into Azure Container Apps secrets/env vars. Do not commit real secrets.

# Required secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
COOKIE_SECRET=replace-with-a-long-random-secret
GOOGLE_API_KEY=replace-with-google-api-key
RAPIDAPI_KEY=replace-with-rapidapi-key
WEATHER_API_KEY=replace-with-weather-api-key

# Optional tracing secrets/settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=viettrip-ai
LANGCHAIN_TRACING_V2=false

# Cookie/security
COOKIE_SECURE=true

# Database pool/retention
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=30
CHECKPOINT_RETENTION_DAYS=30
CONVERSATION_RETENTION_DAYS=90

# External API non-secret overrides
BOOKING_RAPIDAPI_HOST=booking-com15.p.rapidapi.com
GEOCODING_RAPIDAPI_HOST=booking-com15.p.rapidapi.com
GOOGLE_FLIGHT_RAPIDAPI_HOST=google-flights2.p.rapidapi.com
BOOKING_LANGUAGE_CODE=vi
BOOKING_CURRENCY_CODE=VND
COUNTRY_CODE=vn

# MCP sidecar readiness for web container
MCP_SIDECAR_HOST=127.0.0.1
MCP_SIDECAR_PORTS=8001,8002,8003,8004,8005
MCP_STARTUP_TIMEOUT_SECONDS=90
MCP_STARTUP_CHECK_INTERVAL_SECONDS=2
PORT=5000

# Long-term memory rollout flags
LONG_TERM_MEMORY_RECALL_ENABLED=false
LONG_TERM_MEMORY_WRITE_ENABLED=false
LONG_TERM_MEMORY_SYNC_FINALIZE=false
LONG_TERM_MEMORY_RECALL_LIMIT=5
LONG_TERM_MEMORY_WORKER_RETRY_LIMIT=3
LONG_TERM_MEMORY_TEXT_SEARCH_LIMIT=50
LONG_TERM_MEMORY_DEBUG_ENABLED=false

# Candidate extraction
LONG_TERM_MEMORY_EXTRACTOR=deterministic
LONG_TERM_MEMORY_LANGMEM_MODEL=gemini-3.6-flash

# TrustMem-inspired verifier
LONG_TERM_MEMORY_VERIFIER=deterministic
LONG_TERM_MEMORY_TRUSTMEM_MODEL=heuristic-trustmem-v1
LONG_TERM_MEMORY_TRUSTMEM_PROMPT_VERSION=trustmem-verifier-v2
LONG_TERM_MEMORY_TRUSTMEM_TIMEOUT_SECONDS=30
LONG_TERM_MEMORY_TRUSTMEM_COVERAGE_THRESHOLD=0.80
LONG_TERM_MEMORY_TRUSTMEM_PRESERVATION_THRESHOLD=0.90
LONG_TERM_MEMORY_TRUSTMEM_FAITHFULNESS_THRESHOLD=0.95

# Memory transition/applicability inference
LONG_TERM_MEMORY_TRANSITION_PATH=llm
LONG_TERM_MEMORY_TRANSITION_MODEL=gemini-2.5-flash
LONG_TERM_MEMORY_TRANSITION_CONFIDENCE_THRESHOLD=0.85
LONG_TERM_MEMORY_TRANSITION_BATCH_SIZE=10
LONG_TERM_MEMORY_DOMAIN_CANDIDATE_LIMIT=50
LONG_TERM_MEMORY_ACTION_INFERENCE_ENABLED=false
LONG_TERM_MEMORY_APPLICABILITY_JUDGE_ENABLED=true
LONG_TERM_MEMORY_APPLICABILITY_BATCH_SIZE=10

# Shared temporary lock for RapidAPI calls within one container revision
RAPIDAPI_LOCK_FILE=/tmp/viettrip-rapidapi.lock

# pgvector semantic memory recall. Keep disabled until pgvector preflight, migration, dimension verification, and backfill pass.
LONG_TERM_MEMORY_VECTOR_SEARCH_ENABLED=false
LONG_TERM_MEMORY_VECTOR_FALLBACK_ENABLED=true
LONG_TERM_MEMORY_EMBEDDING_MODEL=models/gemini-embedding-001
LONG_TERM_MEMORY_VECTOR_DIMS=3072
LONG_TERM_MEMORY_VECTOR_DISTANCE_THRESHOLD=0.35
LONG_TERM_MEMORY_EMBEDDING_BACKFILL_BATCH_SIZE=100
